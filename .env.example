BACKEND_PORT=3000

DB_PORT=5433
DB_USER=connect4
DB_PASSWORD=connect4
DB_NAME=connect4

# Signs login tokens. Use a long random value (at least 32 chars), never commit the real one.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-secret-value

# Encrypts the 2FA secrets stored in the database. 64 hex chars, never commit the real one.
# Generate one with: openssl rand -hex 32
# Changing it later makes existing 2FA secrets unreadable.
TWO_FACTOR_KEY=replace-me-with-64-hex-characters-from-openssl-rand-hex-32-aaaa
