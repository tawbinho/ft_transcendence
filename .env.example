# Host port of the HTTPS entry point: https://localhost:<port>
HTTPS_PORT=8443

DB_PORT=5433
DB_USER=connect4
DB_PASSWORD=connect4
DB_NAME=connect4


# Encrypts the 2FA secrets stored in the database. 64 hex chars, never commit the real one.
# Generate one with: openssl rand -hex 32
# Changing it later makes existing 2FA secrets unreadable.
TWO_FACTOR_KEY=replace-me-with-64-hex-characters-from-openssl-rand-hex-32-aaaa

# How long a login lasts, in days (optional, default 7).
# SESSION_TTL_DAYS=7

# Verification emails through Gmail: your address + an APP PASSWORD
# (Google account > Security > 2-Step Verification > App passwords).
# Leave empty to only print the link in the backend log.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
