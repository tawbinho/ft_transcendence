# Build settings, read by Vite. For `npm run dev`, copy this file to
# .env.local and change what you need; with Docker, pass them as build
# arguments instead (see the Dockerfile).

# Features answered by the in-browser demo server until the backend serves
# their routes (see src/config.ts and docs/api-contract.md).
# Not set: every demo feature. Empty: none, everything goes to the backend.
# Values: users, friends, chat, spectate, tournaments
VITE_DEMO_FEATURES=users,friends,chat,spectate,tournaments

# "socket" to receive live updates over Socket.IO once the backend has a
# gateway. Anything else: pages refresh themselves by polling.
VITE_REALTIME=

# Development only: where `npm run dev` forwards /api and /socket.io.
# Default: the HTTPS proxy of `docker compose up`.
# API_PROXY_TARGET=https://localhost:8443
