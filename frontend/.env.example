# Build settings, read by Vite. For `npm run dev`, copy this file to
# .env.local and change what you need; with Docker, pass them as build
# arguments instead (see the Dockerfile).

# "socket" to receive live updates over Socket.IO. Anything else: pages
# refresh themselves by polling.
VITE_REALTIME=

# "off" leaves the 3D board (and Three.js) out of the build, so games only
# have the 2D board. Anything else keeps the 2D/3D switch.
VITE_BOARD_3D=on

# Development only: where `npm run dev` forwards /api and /socket.io.
# Default: the HTTPS proxy of `docker compose up`.
# API_PROXY_TARGET=https://localhost:8443
